#!/usr/bin/env bash
# Counting ccusage stub. Records every invocation and serves a fixture.
#
# Invocation counts are the primary assertion in this suite: they are exact,
# fast and hermetic, where asserting CPU seconds would be none of those and
# would produce a flaky gate that gets ignored, then disabled, then deleted.
printf '%s\n' "$*" >> "${CCUSAGE_CALL_LOG:-/dev/null}"

# Every query the panel makes is `claude <subcommand> ...` -- scoped so the
# panel reports Claude Code's spend rather than every agent CLI's. Accept the
# unscoped form too, so this stub keeps working if a query is ever added
# without the prefix rather than silently serving the wrong fixture.
sub="$1"; [ "$sub" = "claude" ] && sub="$2"
case "$sub" in
  daily)   fixture=daily.json ;;
  weekly)  fixture=weekly.json ;;
  monthly) fixture=monthly.json ;;
  session) fixture=session.json ;;
  blocks)  fixture=blocks.json ;;
  *)       printf 'ccusage stub: unhandled subcommand %s\n' "$sub" >&2; exit 70 ;;
esac

path="${CCUSAGE_FIXTURE_DIR:?}/$fixture"
if [ ! -f "$path" ]; then
  printf 'ccusage stub: missing fixture %s\n' "$path" >&2
  exit 70
fi
cat "$path"
