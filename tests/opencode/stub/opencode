#!/usr/bin/env bash
# Counting opencode stub, same discipline as tests/stub/ccusage: record every
# invocation, serve a fixture, never touch the real 80MB database.
printf '%s\n' "$*" >> "${OC_CALL_LOG:-/dev/null}"
case "$1 $2" in
  "session list") fixture=session-list.json ;;
  "stats --days") fixture="stats-$3.json" ;;
  "export "*) fixture=export.json ;;
  *) printf 'opencode stub: unhandled: %s\n' "$*" >&2; exit 70 ;;
esac
path="${OC_FIXTURE_DIR:?}/$fixture"
[ -f "$path" ] || { printf 'opencode stub: missing fixture %s\n' "$path" >&2; exit 70; }
cat "$path"
